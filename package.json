{
	"name": "@laranatech/event-bus",
	"version": "1.0.1",
	"description": "Larana EventBus",
	"keywords": ["event bus", "events", "larana"],
	"license": "MIT",
	"author": "Evgenii Kucheriavii",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"import": "./dist/index.js",
		"require": "./dist/index.cjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/laranatech/event-bus.git"
	},
	"scripts": {
		"dev": "vite",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"ts-check": "tsc --noEmit",
		"check": "npm run lint & npm run ts-check",
		"build": "tsup"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"eslint": "^9.21.0",
		"globals": "^16.0.0",
		"tsup": "^8.4.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.25.0",
		"vite": "^6.2.3",
		"vitest": "^3.0.7"
	}
}
